#Brute force solution to find the length of the longest consecutive sequence in an unsorted array of integers.  

nums = [1,99,101,98,2,5,3,100,1,1]
maxcount = 0
for i in range(len(nums)):
    num = nums[i]
    count = 1
    while num + 1 in nums:
        num += 1
        count += 1
        
maxcount = max(maxcount, count)

print(maxcount)



#Optimal solution to find the length of the longest consecutive sequence in an unsorted array of integers.  
nums = [1, 1, 1, 2, 3, 5, 98, 99, 100, 101]

nums.sort()

count = 0
last_smaller = float("-inf")
longest = 0

for i in range(0, len(nums)):
    num = nums[i]

    if num - 1 == last_smaller:
        count += 1
        last_smaller = num

    elif num != last_smaller:
        count = 1
        last_smaller = num

    longest = max(longest, count)

print(longest)